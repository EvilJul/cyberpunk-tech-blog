# 生成独立随机密钥：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 生产环境必须填写；禁止提交 .env
JWT_SECRET=
JWT_EXPIRES_IN=1h
NODE_ENV=development

# 所有持久数据：blog.db、uploads/、logs/、backups/ 和历史统计迁移源
# 留空使用 server/data；生产推荐绝对路径。Compose 固定使用卷内 /app/data。
BLOG_DATA_DIR=
# 留空使用 BLOG_DATA_DIR/backups；Compose 固定使用 /app/data/backups
BLOG_BACKUP_DIR=

PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=9098
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3033
# 本机同进程网络；Compose 自动覆盖为 http://public:9098
PUBLIC_API_URL=http://127.0.0.1:9098
# Compose 宿主公开监听地址；管理端固定宿主 127.0.0.1
PUBLIC_BIND=0.0.0.0

# canonical / RSS / sitemap 的可信公开地址（生产使用真实 HTTPS 域名）
SITE_URL=http://localhost:9098
CORS_ORIGIN=http://localhost:9099,http://localhost:3033,http://127.0.0.1:3033
ADMIN_CORS_ORIGINS=http://localhost:3033,http://127.0.0.1:3033
# 逗号分隔可信代理 IP/CIDR；空值不信任代理，勿填 true 或 false
TRUST_PROXY=

# 构建与服务运行共用前缀；修改后重建前端/镜像；SITE_URL 同时包含此前缀
VITE_BASE_PATH=/
LOG_LEVEL=info

# 新工作台使用同源 Cookie；生产 HTTPS 必须 true。
# 本地 HTTP（包括本机 Compose）显式 false；勿复制该覆盖到生产。
SESSION_COOKIE_SECURE=false
# 旧 JWT 过渡保留；A/B 验收及全部调用方迁移完成后才关闭。
LEGACY_JWT_ENABLED=true
# 默认关闭机器 API 与密钥创建，验收后由运维显式启用。
PUBLISHING_API_ENABLED=false
