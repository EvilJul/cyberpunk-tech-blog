{
  "name": "reproduction",
  "version": "1.0.0",
  "type": "module",
  "description": "轻量级博客服务系统，支持文章管理、评论、分类标签、全文搜索",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "admin": "node server/index-admin.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:platform": "node --test tests/platform.test.js",
    "migrate:stats": "node scripts/migrate-stats.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
