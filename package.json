    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.20.0",
    "morgan": "^1.11.0",
    "motion": "^12.40.0",
    "multer": "^2.2.0",
    "ogl": "^1.0.11",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
